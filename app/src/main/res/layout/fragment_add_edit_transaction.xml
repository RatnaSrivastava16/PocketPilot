<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="40dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/outline_arrow_back_ios_24"
                android:padding="4dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:tint="@color/text_primary" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Transaction"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_centerInParent="true" />

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log a new financial entry"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp" />

        <!-- Amount card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/balance_card_bg"
            app:strokeColor="@color/text_primary_dark"
            app:strokeWidth="0.5dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMOUNT (₹)"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Type toggle: Income / Expense -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TYPE"
            android:textSize="10sp"
            android:textColor="@color/text_primary_dark"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeExpense"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Expense"
                android:textSize="13sp"
                android:textColor="@color/expense_red"
                android:backgroundTint="@color/expense_bg"
                android:strokeColor="@color/expense_red"
                android:strokeWidth="0.5"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeIncome"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Income"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg"
                android:strokeColor="@color/text_muted"
                android:strokeWidth="0.5"
                />

        </LinearLayout>

        <!-- Hidden spinner (kept for ViewModel compatibility) -->
        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Category chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textSize="10sp"
            android:textColor="@color/text_primary_dark"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/chipFood"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🍔 Food"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />

            <Button
                android:id="@+id/chipTravel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="✈️ Travel"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />

            <Button
                android:id="@+id/chipShopping"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🛍️ Shop"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/chipBills"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="💡 Bills"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />

            <Button
                android:id="@+id/chipHealth"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="❤️ Health"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />

            <Button
                android:id="@+id/chipEntertainment"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🎬 Fun"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/chipSalary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="💼 Salary"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />

            <Button
                android:id="@+id/chipOther"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="💰 Other"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:backgroundTint="@color/card_bg" />

            <!-- spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Hidden category text field (kept for ViewModel compatibility) -->
        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Note field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTE (OPTIONAL)"
            android:textSize="10sp"
            android:textColor="@color/text_primary_dark"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/text_primary"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Add a note..."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@null"
                android:padding="14dp"
                android:minLines="2"
                android:gravity="top" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Transaction"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/card_bg"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/input_border_bg"
            android:layout_marginBottom="8dp" />

        <!-- Budget Alert -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/expense_red"
            app:strokeWidth="0.5dp"
            app:cardBackgroundColor="@color/budget_alert_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/expense_red" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUDGET ALERT"
                        android:textSize="10sp"
                        android:textColor="@color/expense_red"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvBudgetSummaryEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No budget set yet"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>