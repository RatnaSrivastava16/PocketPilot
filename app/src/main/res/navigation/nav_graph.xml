<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/homeFragment">

    <fragment android:id="@+id/homeFragment"
        android:name="com.example.pocketpilot.ui.home.HomeFragment"
        android:label="Home"/>
    <fragment android:id="@+id/transactionsFragment"
        android:name="com.example.pocketpilot.ui.transactions.TransactionsFragment"
        android:label="Transactions">
        <action
            android:id="@+id/action_transactionsFragment_to_addEditTransactionFragment"
            app:destination="@id/addEditTransactionFragment" />
    </fragment>
    <fragment android:id="@+id/addEditTransactionFragment"
        android:name="com.example.pocketpilot.ui.transactions.AddEditTransactionFragment"
        android:label="Add Transaction" />
    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.example.pocketpilot.ui.analytics.AnalyticsFragment"
        android:label="Analytics" />
</navigation>