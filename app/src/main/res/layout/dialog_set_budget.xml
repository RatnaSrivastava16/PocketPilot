<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvBudgetDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Category Budgets"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:text="Enter monthly budget for each category"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍔 FOOD BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etFoodBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ TRAVEL BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etTravelBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛍️ SHOPPING BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etShoppingBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 BILLS BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etBillsBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ HEALTH BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etHealthBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 ENTERTAINMENT BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etEntertainmentBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 OTHER BUDGET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@color/balance_card_bg"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etOtherBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null"
                    android:padding="14dp" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancelBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dialog_btn_secondary"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Cancel"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSaveBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dialog_btn_primary"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Save"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</ScrollView>